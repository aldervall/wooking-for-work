{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/rules/*.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "mcp": {
    "affine": {
      "type": "local",
      "enabled": false,
      "description": "AFFiNE workspace — docs, databases, tags, collections (set AFFINE_* env vars in .env to enable)",
      "command": [
        "affine-mcp"
      ],
      "environment": {
        "AFFINE_BASE_URL": "{env:AFFINE_BASE_URL}",
        "AFFINE_API_TOKEN": "{env:AFFINE_API_TOKEN}",
        "AFFINE_MCP_AUTH_MODE": "{env:AFFINE_MCP_AUTH_MODE}"
      }
    },
    "arbetsformedlingen": {
      "type": "local",
      "enabled": true,
      "description": "Swedish job market — search, enrich, taxonomy",
      "command": [
        "npx",
        "-y",
        "arbetsformedlingen-mcp-server"
      ]
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "description": "Tech docs lookup — resolve libraries, query docs",
      "url": "https://mcp.context7.com/mcp"
    },
    "linkedin": {
      "type": "local",
      "enabled": true,
      "description": "LinkedIn — profile, jobs, company, people search",
      "command": [
        "scripts/linkedin-mcp.sh"
      ],
      "environment": {
        "LINKEDIN_EMAIL": "{env:LINKEDIN_EMAIL}",
        "LINKEDIN_PASSWORD": "{env:LINKEDIN_PASSWORD}"
      }
    },
    "reactive-resume": {
      "type": "remote",
      "enabled": true,
      "description": "RxResume — list, get, patch, duplicate resumes (API Key)",
      "url": "https://resume.aldervall.se/mcp",
      "headers": {
        "x-api-key": "ixCnogdppfgJGHzLcSKNDpyIuNrkUncbGaVfShAMdYOstPKVlQywKMsnLMzPfYeg"
      }
    },
    "claude-cli": {
      "type": "local",
      "command": ["node", "/root/opencode/mcp-server/dist/claude-mcp.js"],
      "enabled": true
    },
    "affine-workspace": {
      "type": "streamable-http",
      "enabled": true,
      "description": "Read docs from AFFiNE workspace",
      "url": "https://affine.aldervall.se/api/workspaces/ef4c1ba3-f9e4-44ae-a0a7-c71bb7828b30/mcp",
      "headers": {
        "Authorization": "Bearer {env:AFFINE_API_TOKEN}"
      }
    }
  },
  "agent": {
    "job-scraper": {
      "description": "Searches IT jobs on AF + LinkedIn and creates AFFiNE docs",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/job-scraper.md}"
    },
    "resume-tailor": {
      "description": "Tailors resumes and creates cover letters for specific jobs",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/resume-tailor.md}"
    },
    "affine-docs": {
      "description": "Creates/manages AFFiNE documents for job tracking",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/affine-docs.md}"
    },
    "research": {
      "description": "Researches companies, tech, and hiring managers",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/research.md}"
    },
    "resume-optimizer": {
      "description": "Multi-agent CrewAI pipeline: analyzes jobs, scores resume match, generates JSON Patch operations for Reactive Resume",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/resume-optimizer.md}"
    }
  }
}