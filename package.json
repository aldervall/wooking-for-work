{
  "name": "wooking-for-work",
  "version": "1.0.0",
  "description": "Job search pipeline manager - Swedish market focus",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed-database.js",
    "db:reset": "rm -f data/wooking.db && npm run seed",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:preview": "npm run preview --prefix frontend",
    "dev:full": "concurrently -n api,web -c blue,green \"npm run dev\" \"npm run frontend:dev\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.7.0",
    "connect-sqlite3": "^0.9.15",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "playwright": "^1.60.0",
    "uuid": "^11.0.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
