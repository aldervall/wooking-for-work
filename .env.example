# =============================================================================
# Wooking for Work — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# All MCP servers are configured in opencode.json to read from these
# environment variables via {env:VAR} syntax.
# =============================================================================

# --- OpenAI (Required for CrewAI resume optimizer) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
# Model for CrewAI agents (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# --- Reactive Resume (Required for resume operations) ---
# Get your API key from your RxResume instance settings
RXRESUME_API_KEY=your-rxresume-api-key
# REST API base URL (self-hosted or https://rxresu.me/api/openapi)
RXRESUME_API_BASE=https://rxresu.me/api/openapi
# MCP endpoint URL — opencode will prompt OAuth flow on first use
RXRESUME_MCP_URL=https://rxresu.me/mcp

# --- AFFiNE (Required for document management) ---
# Your AFFiNE instance URL (self-hosted or https://app.affine.pro)
AFFINE_BASE_URL=http://localhost:3010
# Generate an API token from AFFiNE Settings > Workspace > API Tokens
AFFINE_API_TOKEN=your-affine-api-token
AFFINE_MCP_AUTH_MODE=bearer

# --- LinkedIn (Required for LinkedIn scraping) ---
# Your LinkedIn login credentials
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=your-password
